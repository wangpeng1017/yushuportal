# 预发布环境：只在打包时使用
NODE_ENV=production

VITE_DEV=false

# 请求路径
VITE_BASE_URL=''
VITE_IIMAKE_CLIENT_ID=8639cc903277a8865f44da1dde5cbb65
VITE_IIMAKE_SSO_URL=https://umc-test.iimake.com/api/admin-api/system/oauth2/authorize

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH='/'

# 输出路径
VITE_OUT_DIR=dist

# 商城H5会员端域名
VITE_MALL_H5_DOMAIN=''

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'

# === UniTree autoLogin（演示环境默认开）===
VITE_AUTO_LOGIN=true
VITE_AUTO_LOGIN_USER=admin
VITE_AUTO_LOGIN_PASS=admin123
VITE_AUTO_LOGIN_TENANT=
