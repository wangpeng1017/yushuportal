# Mock模式：不连后端，所有API走本地mock（开发+构建均可用）
NODE_ENV=production

VITE_DEV=false

# 关键：base_url 为空，让请求走 vite dev server → mock 拦截
VITE_BASE_URL=''

# 关闭外部 SSO 跳转，纯前端 demo
VITE_IIMAKE_CLIENT_ID=
VITE_IIMAKE_SSO_URL=

VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin-api

VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=false
VITE_BASE_PATH=/

# 关闭验证码
VITE_APP_CAPTCHA_ENABLE=false

# 关闭租户
VITE_APP_TENANT_ENABLE=false

# 自动登录：打开 URL 直接进系统，演示零摩擦
VITE_AUTO_LOGIN=true
VITE_AUTO_LOGIN_USER=admin
VITE_AUTO_LOGIN_PASS=admin123
VITE_AUTO_LOGIN_TENANT=
