# Mock 模式：纯前端 demo，所有 API 请求由前端 mock-bridge 拦截
NODE_ENV=production

VITE_DEV=false

# 关键：base_url 留空，请求走相对路径，由 axios adapter 拦截
VITE_BASE_URL=''

# 关闭外部 SSO 跳转，纯前端 demo
VITE_IIMAKE_CLIENT_ID=
VITE_IIMAKE_SSO_URL=

VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin-api

VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=false
VITE_BASE_PATH=/

# 关闭验证码
VITE_APP_CAPTCHA_ENABLE=false

# 关闭租户
VITE_APP_TENANT_ENABLE=false

# 输出路径
VITE_OUT_DIR=dist

VITE_MALL_H5_DOMAIN=''
VITE_GOVIEW_URL='http://127.0.0.1:3000'

# Mock 演示模式：跳过 SSO，直接登录
VITE_MOCK_MODE=true

# 应用标题（覆盖 .env 默认值）
VITE_APP_TITLE=宇树科技

# 自动登录：true=零摩擦演示；false=展示登录页（飞书扫码/账号密码 Demo）
VITE_AUTO_LOGIN=false
VITE_AUTO_LOGIN_USER=admin
VITE_AUTO_LOGIN_PASS=admin123
VITE_AUTO_LOGIN_TENANT=
