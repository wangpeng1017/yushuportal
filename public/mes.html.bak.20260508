                {confirmStatus: '待确认', scheduleStatus: '未排产', orderType: '标准订单', orderNo: 'SCDD004', lineNo: '1', materialCode: 'MAT005', materialName: '外壳', spec: 'ABS', workshop: 'B端生产车间', qty: '300', scheduledQty: '0', unit: '个', startDate: '2026-04-29', endDate: '2026-05-03', batch: '260429001', creator: 'admin', createTime: '2026-04-25 10:20:00', modifier: 'admin', modifyTime: '2026-04-25 10:20:00', remark: '标准生产订单'},
                {confirmStatus: '已确认', scheduleStatus: '部分排产', orderType: '返工订单', orderNo: 'FGDD002', lineNo: '1', materialCode: 'MAT001', materialName: '电机', spec: '1.5kW', workshop: 'C端生产车间', qty: '30', scheduledQty: '15', unit: '台', startDate: '2026-04-27', endDate: '2026-04-29', batch: '260427002', creator: 'admin', createTime: '2026-04-25 10:25:00', modifier: 'admin', modifyTime: '2026-04-25 10:25:00', remark: '返工订单'},
                {confirmStatus: '已确认', scheduleStatus: '未排产', orderType: '标准订单', orderNo: 'SCDD005', lineNo: '1', materialCode: 'MAT003', materialName: '传感器', spec: '10mm', workshop: 'A端生产车间', qty: '80', scheduledQty: '0', unit: '个', startDate: '2026-04-30', endDate: '2026-05-04', batch: '260430001', creator: 'admin', createTime: '2026-04-25 10:30:00', modifier: 'admin', modifyTime: '2026-04-25 10:30:00', remark: '标准生产订单'}
