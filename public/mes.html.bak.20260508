                        </div>
                    `;
                    break;
                default:
                    headerHTML = `
                        <tr>
                            <th><input type="checkbox"></th>
                            <th>编码</th>
                            <th>名称</th>
                            <th>状态</th>
                            <th>创建人</th>
                            <th>创建时间</th>
                            <th>修改人</th>
                            <th>修改时间</th>
                            <th>备注</th>
                            <th>操作</th>
                        </tr>
                    `;
            }

            tableHeader.innerHTML = headerHTML;
        }

        // 更新表格内容
        function updateTableContent(module) {
            const tbody = document.getElementById('table-body');

            // 清空表格
            tbody.innerHTML = '';

            // 根据模块生成不同的表格内容
            switch(module) {
                case 'workshop':
                    generateWorkshopTable(tbody);
                    break;
                case 'production-line':
                    generateProductionLineTable(tbody);
                    break;
                case 'team':
                    generateTeamTable(tbody);
                    break;
                case 'material':
                    generateMaterialTable(tbody);
                    break;
                case 'template':
                    generateTemplateTable(tbody);
                    break;
                case 'personnel':
                    generatePersonnelTable(tbody);
                    break;
                case 'bom':
                    generateBOMTable(tbody);
                    break;
                case 'exception':
                    generateExceptionTable(tbody);
                    break;
                case 'skill':
                    generateSkillTable(tbody);
                    break;
                case 'process':
                    generateProcessTable(tbody);
                    break;
                case 'product-process':
                    generateProductProcessTable(tbody);
                    break;
                case 'production-order':
                    generateProductionOrderTable(tbody);
                    break;
                case 'factory-calendar':
                    generateFactoryCalendarTable(tbody);
                    break;
                case 'production-plan':
                    generateProductionPlanTable(tbody);
                    break;
                case 'work-order':
                    generateWorkOrderTable(tbody);
                    break;
                case 'pre-check':
                    generatePreCheckTable(tbody);
                    break;
                case 'material-request':
                    generateMaterialRequestTable(tbody);
                    break;
                case 'material-transfer':
                    generateMaterialTransferTable(tbody);
                    break;
                case 'worker-on-duty':
                    generateWorkerOnDutyTable(tbody);
                    break;
                case 'material-online':
                    generateMaterialOnlineTable(tbody);
                    break;
                case 'production-report':
                    generateProductionReportTable(tbody);
                    break;
                case 'quality-report':
                    generateQualityReportTable(tbody);
                    break;
                case 'quality-inspection':
                    generateQualityInspectionTable(tbody);
                    break;
                case 'rework-notice':
                    generateReworkNoticeTable(tbody);
                    break;
                case 'repair-record':
                    generateRepairRecordTable(tbody);
                    break;
                case 'production-return':
                    generateProductionReturnTable(tbody);
                    break;
                case 'production-storage':
                    generateProductionStorageTable(tbody);
                    break;
                case 'rework-management':
                    generateReworkManagementTable(tbody);
                    break;
                case 'exception-management':
                    generateExceptionManagementTable(tbody);
                    break;
                case 'time-report':
                    generateTimeReportTable(tbody);
                    break;
                case 'five-s-check':
                    generateFiveSCheckTable(tbody);
                    break;
                case 'test-order':
                    generateTestOrderTable(tbody);
                    break;
                case 'repair-transfer':
                    generateRepairTransferTable(tbody);
                    break;
                case 'package-check':
                    generatePackageCheckTable(tbody);
                    break;
                case 'kit-inbound':
                    generateKitInboundTable(tbody);
                    break;
                case 'repair-order':
                    generateRepairOrderTable(tbody);
                    break;
                case 'repair-issue':
                    generateRepairIssueTable(tbody);
                    break;
                case 'sn-reprint':
                    generateSNReprintTable(tbody);
                    break;
                case 'product-replace':
                    generateProductReplaceTable(tbody);
                    break;
                case 'repair-inspection':
                    generateRepairInspectionTable(tbody);
                    break;
                default:
                    generateDefaultTable(tbody, module);
            }
        }

        // 生成终端主页
        function generateTerminalHomePage() {
            const content = document.querySelector('.content');
            content.innerHTML = `
                <style>
                    .terminal-container {
                        padding: 20px;
                    }
                    .terminal-header {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        margin-bottom: 20px;
                    }
                    .terminal-title {
                        font-size: 24px;
                        font-weight: bold;
                        color: #1a365d;
                    }
                    .terminal-info {
                        display: flex;
                        gap: 20px;
                        font-size: 14px;
