                        {batchCode: 'BATCH003', materialCode: 'MAT006', materialName: '铜线', spec: '2.5mm', originalWorkOrder: 'WO001', newWorkOrder: 'WO006'}
                    ]
                },
                'RW002': {
                    materials: [
