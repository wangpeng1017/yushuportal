                        <div style="display: flex; gap: 15px;">
                            <div class="form-group" style="flex: 1;">
                                <label for="form-part-material-code">配件物料编码</label>
                                <input type="text" id="form-part-material-code" placeholder="自动填充" disabled>
                            </div>
