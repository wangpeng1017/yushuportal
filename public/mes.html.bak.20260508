                                <label>批次码迁移表</label>
                                <div class="data-table" style="margin-top: 5px;">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>批次码</th>
                                                <th>物料编码</th>
                                                <th>物料名称</th>
                                                <th>规格型号</th>
                                                <th>原工单号</th>
                                                <th>新工单号</th>
                                            </tr>
                                        </thead>
                                        <tbody id="batch-migration-body">
                                            <tr>
                                                <td colspan="6" style="text-align: center; color: #999;">请先选择生产工单</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" style="display: none;">
