        // 生成车间管理表格
        function generateWorkshopTable(tbody) {
            const workshops = [
                {code: 'C001', name: 'C端生产车间', status: 'normal', defaultLine: 'C端装配线', creator: 'admin', createTime: '2026-04-01 10:00:00', modifier: 'admin', modifyTime: '2026-04-01 10:00:00', remark: '负责C端产品生产'},
                {code: 'B001', name: 'B端生产车间', status: 'normal', defaultLine: 'B端装配线', creator: 'admin', createTime: '2026-04-01 10:05:00', modifier: 'admin', modifyTime: '2026-04-01 10:05:00', remark: '负责B端产品生产'},
                {code: 'M001', name: '机加工车间', status: 'maintenance', defaultLine: '机加工线', creator: 'admin', createTime: '2026-04-01 10:10:00', modifier: 'admin', modifyTime: '2026-04-10 14:30:00', remark: '负责机械加工'},
                {code: 'L001', name: '物流服务车间', status: 'normal', defaultLine: '物流分拣线', creator: 'admin', createTime: '2026-04-01 10:15:00', modifier: 'admin', modifyTime: '2026-04-01 10:15:00', remark: '负责物流配送'},
                {code: 'S001', name: '售后维修车间', status: 'disabled', defaultLine: '维修线', creator: 'admin', createTime: '2026-04-01 10:20:00', modifier: 'admin', modifyTime: '2026-04-01 10:20:00', remark: '负责产品维修'}
            ];

            workshops.forEach(workshop => {
                const statusClass = workshop.status === 'normal' ? 'status-success' : workshop.status === 'maintenance' ? 'status-warning' : 'status-danger';
                const statusText = workshop.status === 'normal' ? '正常' : workshop.status === 'maintenance' ? '维护中' : '未启用';
                
                const row = `
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>${workshop.code}</td>
                        <td>${workshop.name}</td>
                        <td><span class="status-tag ${statusClass}">${statusText}</span></td>
                        <td>${workshop.defaultLine}</td>
                        <td>${workshop.creator}</td>
                        <td>${workshop.createTime}</td>
                        <td>${workshop.modifier}</td>
                        <td>${workshop.modifyTime}</td>
                        <td>${workshop.remark}</td>
                        <td>
                            <button class="btn btn-primary" style="padding: 4px 8px; font-size: 12px;" onclick="openModal('edit')"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-danger" style="padding: 4px 8px; font-size: 12px;" onclick="confirmDelete()"><i class="fas fa-trash"></i></button>
                            <button class="btn btn-primary" style="padding: 4px 8px; font-size: 12px;" onclick="openDetailModal()"><i class="fas fa-eye"></i></button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

