        // 更新原工单信息
        function updateOriginalWorkOrderInfo() {
            const workOrderSelect = document.getElementById('form-original-work-order');
            const materialCodeInput = document.getElementById('form-material-code');
            const materialNameInput = document.getElementById('form-material-name');
            const specInput = document.getElementById('form-spec');
            const materialMigrationBody = document.getElementById('material-migration-body');
            const batchMigrationBody = document.getElementById('batch-migration-body');

            const selectedWorkOrder = workOrderSelect.value;

            if (selectedWorkOrder && workOrderMaterialInfo[selectedWorkOrder]) {
                const info = workOrderMaterialInfo[selectedWorkOrder];
                materialCodeInput.value = info.materialCode;
                materialNameInput.value = info.materialName;
                specInput.value = info.spec;

                // 更新原材料迁移表
                if (materialMigrationData[selectedWorkOrder]) {
                    let materialHTML = '';
                    materialMigrationData[selectedWorkOrder].forEach(item => {
                        materialHTML += `
                            <tr>
                                <td>${item.materialCode}</td>
                                <td>${item.materialName}</td>
                                <td>${item.spec}</td>
                                <td>${item.originalReturnQty}</td>
                                <td>${item.newIssueQty}</td>
                                <td>${item.pendingQty}</td>
                                <td>${item.batchCode}</td>
                            </tr>
                        `;
                    });
                    materialMigrationBody.innerHTML = materialHTML;
                } else {
                    materialMigrationBody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #999;">无原材料迁移数据</td></tr>';
                }

                // 更新批次码迁移表
                if (batchMigrationData[selectedWorkOrder]) {
                    let batchHTML = '';
                    batchMigrationData[selectedWorkOrder].forEach(item => {
                        batchHTML += `
                            <tr>
                                <td>${item.batchCode}</td>
                                <td>${item.materialCode}</td>
                                <td>${item.materialName}</td>
                                <td>${item.spec}</td>
                                <td>${item.originalWorkOrder}</td>
                                <td>${item.newWorkOrder}</td>
                            </tr>
                        `;
                    });
                    batchMigrationBody.innerHTML = batchHTML;
                } else {
                    batchMigrationBody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #999;">无批次码迁移数据</td></tr>';
                }
            } else {
                materialCodeInput.value = '';
                materialNameInput.value = '';
                specInput.value = '';
                materialMigrationBody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #999;">请先选择生产工单</td></tr>';
                batchMigrationBody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #999;">请先选择生产工单</td></tr>';
            }
        }

        // 更新新工单信息
        function updateNewWorkOrderInfo() {
            const workOrderSelect = document.getElementById('form-new-work-order');
            const qtyInput = document.getElementById('form-new-work-order-qty');

            const selectedWorkOrder = workOrderSelect.value;

            if (selectedWorkOrder && workOrderMaterialInfo[selectedWorkOrder]) {
                const info = workOrderMaterialInfo[selectedWorkOrder];
                qtyInput.value = info.qty;
            } else {
                qtyInput.value = '';
            }
        }

        // 关闭模态框
        function closeModal() {
            const modal = document.getElementById('edit-modal');
            modal.classList.remove('show');
        }

        // 打开详情模态框
        function openDetailModal() {
            const modal = document.getElementById('detail-modal');
            modal.classList.add('show');
        }

        // 打开模板明细模态框
        function openTemplateDetailModal(templateCode) {
            const modal = document.getElementById('detail-modal');
            const modalTitle = document.getElementById('detail-title');
            const modalBody = document.querySelector('.detail-content .modal-body');
            
            // 检查是否是5S点检单号
            if (templateCode.startsWith('5S')) {
                modalTitle.textContent = `5S点检明细 - ${templateCode}`;
            } else if (templateCode.startsWith('PRE')) {
                modalTitle.textContent = `产前点检明细 - ${templateCode}`;
            } else {
                modalTitle.textContent = `检验明细 - ${templateCode}`;
            }
            
            // 模板明细数据
            const templateDetails = {
                'TEMP001': [
                    {category: '电气检查', name: '电机绕组', content: '检查电机绕组是否正常', standard: '无短路、无断路', method: '万用表检测', checkValue: '', pass: '', remark: '', attachment: ''},
                    {category: '机械检查', name: '电机轴承', content: '检查电机轴承是否正常', standard: '无异常噪音', method: '听觉检测', checkValue: '', pass: '', remark: '', attachment: ''},
                    {category: '外观检查', name: '电机外壳', content: '检查电机外壳是否完好', standard: '无变形、无裂纹', method: '目视检查', checkValue: '', pass: '', remark: '', attachment: ''}
                ],
                'TEMP002': [
                    {category: '性能测试', name: '传动效率', content: '测试减速器传动效率', standard: '≥95%', method: '测试台检测', checkValue: '', pass: '', remark: '', attachment: ''},
                    {category: '噪音测试', name: '运行噪音', content: '测试减速器运行噪音', standard: '≤60dB', method: '噪音计检测', checkValue: '', pass: '', remark: '', attachment: ''},
                    {category: '寿命测试', name: '疲劳寿命', content: '测试减速器疲劳寿命', standard: '≥10000小时', method: '耐久性测试', checkValue: '', pass: '', remark: '', attachment: ''}
                ],
