                    auditStatus: '待审核', processStatus: '待处理',
                    desc: '原材料批次不良', reason: '供应商质量问题', measure: '联系供应商退换货',
                    alarmTime: '2026-04-26 14:00', alarmPerson: '赵六',
                    clearTime: '', clearPerson: '', creator: 'admin',
                    createTime: '2026-04-26 13:30:00', remark: ''
                },
                {
                    code: 'EXP004', category: '工艺异常', level: '一般',
                    auditStatus: '已审核', processStatus: '处理中',
                    desc: '装配工艺参数偏移', reason: '设备校准偏差', measure: '重新校准设备',
                    alarmTime: '2026-04-26 09:00', alarmPerson: '钱七',
                    clearTime: '', clearPerson: '', creator: 'admin',
                    createTime: '2026-04-26 08:45:00', remark: ''
                }
            ];

            exceptions.forEach(item => {
                const auditStatusClass = item.auditStatus === '已审核' ? 'status-success' : 'status-warning';
                let processStatusClass = '';
                switch(item.processStatus) {
                    case '待处理': processStatusClass = 'status-danger'; break;
                    case '处理中': processStatusClass = 'status-warning'; break;
                    case '已消除': processStatusClass = 'status-success'; break;
                }
                let levelClass = '';
                switch(item.level) {
                    case '轻微': levelClass = 'status-success'; break;
                    case '一般': levelClass = 'status-warning'; break;
                    case '严重': levelClass = 'status-danger'; break;
                    case '危急': levelClass = 'status-danger'; break;
                }
                
                const row = `
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>${item.code}</td>
                        <td>${item.category}</td>
                        <td><span class="status-tag ${levelClass}">${item.level}</span></td>
                        <td><span class="status-tag ${auditStatusClass}">${item.auditStatus}</span></td>
                        <td><span class="status-tag ${processStatusClass}">${item.processStatus}</span></td>
                        <td>${item.desc}</td>
                        <td>${item.reason}</td>
                        <td>${item.measure}</td>
                        <td>${item.alarmTime}</td>
                        <td>${item.alarmPerson}</td>
                        <td>${item.clearTime}</td>
                        <td>${item.clearPerson}</td>
                        <td>${item.creator}</td>
                        <td>${item.createTime}</td>
                        <td>${item.remark}</td>
                        <td>
