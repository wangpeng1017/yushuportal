            workOrders.forEach((order, index) => {
                const confirmStatusClass = order.confirmStatus === '已确认' ? 'status-success' : 'status-warning';
                let execStatusClass = '';
                switch(order.execStatus) {
                    case '未开工': execStatusClass = 'status-danger'; break;
                    case '执行中': execStatusClass = 'status-warning'; break;
                    case '已完工': execStatusClass = 'status-success'; break;
                }
                const lockStatusClass = order.lockStatus === '正常' ? 'status-success' : 'status-danger';
                let materialRequestClass = '';
                switch(order.materialRequestStatus) {
                    case '未申请': materialRequestClass = 'status-danger'; break;
                    case '部分申请': materialRequestClass = 'status-warning'; break;
                    case '全部申请': materialRequestClass = 'status-success'; break;
                }

                const row = `
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>${order.code}</td>
                        <td>${order.priority}</td>
                        <td><span class="status-tag ${confirmStatusClass}">${order.confirmStatus}</span></td>
                        <td><span class="status-tag ${execStatusClass}">${order.execStatus}</span></td>
                        <td><span class="status-tag ${lockStatusClass}">${order.lockStatus}</span></td>
                        <td><span class="status-tag ${materialRequestClass}">${order.materialRequestStatus}</span></td>
                        <td>${order.materialCode}</td>
                        <td>${order.materialName}</td>
                        <td>${order.spec}</td>
                        <td>${order.qty}</td>
                        <td>${order.planStartDate}</td>
                        <td>${order.planEndDate}</td>
                        <td>${order.actualStartDate}</td>
                        <td>${order.actualEndDate}</td>
                        <td>${order.planCode}</td>
                        <td>${order.orderCode}</td>
                        <td>${order.workshop}</td>
                        <td>${order.line}</td>
                        <td>${order.team}</td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

