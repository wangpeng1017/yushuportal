                        <td>${batch.materialCode}</td>
                        <td>${batch.materialName}</td>
                        <td>${batch.spec}</td>
                        <td>${batch.originalWorkOrder}</td>
                        <td>${batch.newWorkOrder}</td>
                    </tr>
                `;
            });
            
            html += `
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
            
            modalBody.innerHTML = html;
            modal.classList.add('show');
        }

        // 关闭改制管理详情模态框
        function closeReworkDetailModal() {
            const modal = document.getElementById('rework-detail-modal');
            modal.classList.remove('show');
        }

        // 当前要拆分的计划数据
        let currentSplitPlan = null;

        // 当前要派工的计划数据
        let currentDispatchPlan = null;

        // 打开拆分模态框
        function openSplitModal(index) {
            currentSplitPlan = productionPlans[index];
            const modal = document.getElementById('split-modal');
            const tableBody = document.getElementById('split-table-body');

            // 计算拆分后的数量
            const totalQty = parseInt(currentSplitPlan.planQty);
            const qty1 = Math.floor(totalQty / 2);
            const qty2 = totalQty - qty1;

            // 生成两行数据
            tableBody.innerHTML = `
                <tr>
                    <td>${currentSplitPlan.planNo}-1</td>
                    <td>${currentSplitPlan.orderNo}</td>
                    <td>${currentSplitPlan.materialCode}</td>
                    <td>${currentSplitPlan.materialName}</td>
                    <td>${currentSplitPlan.spec}</td>
                    <td><input type="number" id="split-qty-1" value="${qty1}" style="width: 80px;"></td>
                    <td>${currentSplitPlan.unit}</td>
                    <td><input type="date" id="split-start-1" value="${currentSplitPlan.startDate}" style="width: 120px;"></td>
                    <td><input type="date" id="split-end-1" value="${currentSplitPlan.endDate}" style="width: 120px;"></td>
                    <td>${currentSplitPlan.workshop}</td>
                </tr>
                <tr>
                    <td>${currentSplitPlan.planNo}-2</td>
                    <td>${currentSplitPlan.orderNo}</td>
                    <td>${currentSplitPlan.materialCode}</td>
                    <td>${currentSplitPlan.materialName}</td>
                    <td>${currentSplitPlan.spec}</td>
                    <td><input type="number" id="split-qty-2" value="${qty2}" style="width: 80px;"></td>
                    <td>${currentSplitPlan.unit}</td>
                    <td><input type="date" id="split-start-2" value="${currentSplitPlan.startDate}" style="width: 120px;"></td>
                    <td><input type="date" id="split-end-2" value="${currentSplitPlan.endDate}" style="width: 120px;"></td>
                    <td>${currentSplitPlan.workshop}</td>
                </tr>
            `;

            modal.classList.add('show');
        }

        // 关闭拆分模态框
        function closeSplitModal() {
            const modal = document.getElementById('split-modal');
            modal.classList.remove('show');
            currentSplitPlan = null;
        }

        // 打开派工模态框
        function openDispatchModal(index) {
            currentDispatchPlan = productionPlans[index];
            const modal = document.getElementById('dispatch-modal');
            const infoDiv = document.getElementById('dispatch-info');

            infoDiv.innerHTML = `
                <div class="dispatch-header">
                    <h4>计划信息</h4>
                </div>
                <div class="dispatch-row">
                    <div class="dispatch-item">
                        <label>计划单号：</label>
                        <span>${currentDispatchPlan.planNo}</span>
                    </div>
                    <div class="dispatch-item">
                        <label>生产订单号：</label>
                        <span>${currentDispatchPlan.orderNo}</span>
                    </div>
                    <div class="dispatch-item">
                        <label>物料编码：</label>
                        <span>${currentDispatchPlan.materialCode}</span>
                    </div>
                </div>
                <div class="dispatch-row">
                    <div class="dispatch-item">
                        <label>物料名称：</label>
                        <span>${currentDispatchPlan.materialName}</span>
                    </div>
                    <div class="dispatch-item">
                        <label>规格型号：</label>
                        <span>${currentDispatchPlan.spec}</span>
                    </div>
                    <div class="dispatch-item">
                        <label>生产车间：</label>
                        <span>${currentDispatchPlan.workshop}</span>
                    </div>
                </div>
                <div class="dispatch-row">
                    <div class="dispatch-item">
                        <label>计划数量：</label>
                        <span>${currentDispatchPlan.planQty} ${currentDispatchPlan.unit}</span>
                    </div>
                    <div class="dispatch-item">
                        <label>已派工数量：</label>
                        <span>${currentDispatchPlan.dispatchedQty} ${currentDispatchPlan.unit}</span>
                    </div>
                    <div class="dispatch-item">
                        <label>可派工数量：</label>
                        <span>${parseInt(currentDispatchPlan.planQty) - parseInt(currentDispatchPlan.dispatchedQty)} ${currentDispatchPlan.unit}</span>
                    </div>
                </div>
                <div class="dispatch-form">
                    <h4>派工信息</h4>
                    <div class="form-row">
                        <div class="form-group">
                            <label>派工数量</label>
                            <input type="number" id="dispatch-qty" value="${parseInt(currentDispatchPlan.planQty) - parseInt(currentDispatchPlan.dispatchedQty)}">
                        </div>
                        <div class="form-group">
                            <label>产线</label>
                            <select id="dispatch-line">
                                <option value="LINE001">C端装配线</option>
                                <option value="LINE002">B端装配线</option>
                                <option value="LINE003">机加工线</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>班组</label>
                            <select id="dispatch-team">
                                <option value="TEAM001">A班</option>
                                <option value="TEAM002">B班</option>
                                <option value="TEAM003">C班</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>设备</label>
                            <select id="dispatch-equipment">
                                <option value="EQP001">设备001</option>
                                <option value="EQP002">设备002</option>
                                <option value="EQP003">设备003</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>开工日期</label>
                            <input type="date" id="dispatch-start" value="${currentDispatchPlan.startDate}">
                        </div>
                        <div class="form-group">
                            <label>完工日期</label>
                            <input type="date" id="dispatch-end" value="${currentDispatchPlan.endDate}">
                        </div>
                    </div>
                </div>
            `;

            modal.classList.add('show');
        }

        // 关闭派工模态框
        function closeDispatchModal() {
            const modal = document.getElementById('dispatch-modal');
            modal.classList.remove('show');
            currentDispatchPlan = null;
        }

        // 确认派工
        function confirmDispatch() {
            if (!currentDispatchPlan) return;

            const dispatchQty = parseInt(document.getElementById('dispatch-qty').value);
            const line = document.getElementById('dispatch-line').value;
            const team = document.getElementById('dispatch-team').value;
            const equipment = document.getElementById('dispatch-equipment').value;
            const startDate = document.getElementById('dispatch-start').value;
            const endDate = document.getElementById('dispatch-end').value;

            // 更新已派工数量
            const newDispatchedQty = parseInt(currentDispatchPlan.dispatchedQty) + dispatchQty;
            const index = productionPlans.indexOf(currentDispatchPlan);
            productionPlans[index] = {
                ...currentDispatchPlan,
                dispatchedQty: newDispatchedQty,
                dispatchStatus: newDispatchedQty >= parseInt(currentDispatchPlan.planQty) ? '已派工' : '部分派工',
                modifier: 'admin',
                modifyTime: new Date().toLocaleString()
            };

            // 刷新表格
            const tableBody = document.querySelector('#data-table tbody');
            tableBody.innerHTML = '';
            generateProductionPlanTable(tableBody);

            alert(`派工成功！派工数量：${dispatchQty}，产线：${line}，班组：${team}，设备：${equipment}`);
            closeDispatchModal();
        }

        // 确认拆分
        function confirmSplit() {
            if (!currentSplitPlan) return;

            const qty1 = parseInt(document.getElementById('split-qty-1').value);
            const qty2 = parseInt(document.getElementById('split-qty-2').value);
            const start1 = document.getElementById('split-start-1').value;
            const start2 = document.getElementById('split-start-2').value;
            const end1 = document.getElementById('split-end-1').value;
            const end2 = document.getElementById('split-end-2').value;

            // 创建两个新计划
            const newPlan1 = {
                ...currentSplitPlan,
                planNo: currentSplitPlan.planNo + '-1',
                planQty: qty1,
                startDate: start1,
                endDate: end1,
                confirmStatus: '未确认',
                dispatchStatus: '未派工',
                dispatchedQty: 0,
                creator: 'admin',
                createTime: new Date().toLocaleString(),
                modifier: 'admin',
                modifyTime: new Date().toLocaleString(),
                remark: '拆分自' + currentSplitPlan.planNo
            };

            const newPlan2 = {
                ...currentSplitPlan,
                planNo: currentSplitPlan.planNo + '-2',
                planQty: qty2,
                startDate: start2,
                endDate: end2,
                confirmStatus: '未确认',
                dispatchStatus: '未派工',
                dispatchedQty: 0,
                creator: 'admin',
                createTime: new Date().toLocaleString(),
                modifier: 'admin',
                modifyTime: new Date().toLocaleString(),
                remark: '拆分自' + currentSplitPlan.planNo
            };

            // 在原位置替换
            const index = productionPlans.indexOf(currentSplitPlan);
            productionPlans.splice(index, 1, newPlan1, newPlan2);

            // 刷新表格
            const tableBody = document.querySelector('#data-table tbody');
            tableBody.innerHTML = '';
            generateProductionPlanTable(tableBody);

            alert('拆分成功！');
            closeSplitModal();
        }

