                                <input type="text" id="form-part-spec" placeholder="自动填充" disabled>
                            </div>
                        </div>
                    `;
                    break;
                case 'product-replace':
                    if (type === 'add') {
                        title = '新增产品换件';
                        formHTML = `
                            <div class="form-group">
                                <label for="form-sn-code">SN号</label>
