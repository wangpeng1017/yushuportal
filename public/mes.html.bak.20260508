    <script>
        // 切换子菜单
        function toggleSubmenu(element) {
            const submenu = element.nextElementSibling;
            submenu.classList.toggle('show');
            const icon = element.querySelector('.fa-chevron-down');
            icon.classList.toggle('fa-chevron-up');
        }

        // 切换模块
        function switchModule(module) {
            // 更新子菜单激活状态
            const submenuItems = document.querySelectorAll('.submenu-item');
            submenuItems.forEach(item => item.classList.remove('active'));
            event.target.classList.add('active');

            // 如果是终端主页，直接生成页面
            if (module === 'terminal-home') {
                generateTerminalHomePage();
                return;
            }

            // 如果之前是终端主页，需要恢复content结构
            const content = document.querySelector('.content');
            if (!document.getElementById('module-title')) {
                content.innerHTML = `
                    <div class="content-header">
                        <h2 class="content-title" id="module-title">车间管理</h2>
                    </div>
                    <div class="filter-section" id="filter-section">
                        <div class="filter-row">
                            <div class="filter-item">
                                <input type="text" id="code" placeholder="编码">
                            </div>
                            <div class="filter-item">
                                <input type="text" id="name" placeholder="名称">
                            </div>
                            <div class="filter-item">
                                <input type="date" id="create-time-start" placeholder="创建时间开始">
                            </div>
                            <div class="filter-item">
                                <input type="date" id="create-time-end" placeholder="创建时间结束">
                            </div>
                        </div>
                        <div class="button-group" id="button-group">
                            <button id="btn-add" class="btn btn-primary" onclick="openModal('add')"><i class="fas fa-plus"></i> 新增</button>
                            <button id="btn-edit" class="btn btn-secondary" onclick="openModal('edit')"><i class="fas fa-edit"></i> 编辑</button>
                            <button id="btn-delete" class="btn btn-danger" onclick="confirmDelete()"><i class="fas fa-trash"></i> 删除</button>
                            <button id="btn-confirm" class="btn btn-success" style="display: none;" onclick="confirmOrder()"><i class="fas fa-check"></i> 确认</button>
                            <button id="merge-btn" class="btn btn-info" style="display: none;" onclick="openMergeModal()"><i class="fas fa-object-group"></i> 合并</button>
                            <button id="btn-material-request" class="btn btn-primary" style="display: none;" onclick="openMaterialRequestModal(0)"><i class="fas fa-clipboard-list"></i> 领料申请</button>
                            <button id="btn-start-work" class="btn btn-success" style="display: none;" onclick="openStartWorkModal(0)"><i class="fas fa-play"></i> 开工</button>
                            <button id="btn-worker-on-duty" class="btn btn-primary" style="display: none;" onclick="openWorkerOnDutyModal(0)"><i class="fas fa-users"></i> 上工</button>
                            <button id="btn-material-online" class="btn btn-primary" style="display: none;" onclick="openMaterialOnlineModal(0)"><i class="fas fa-boxes"></i> 物料上线</button>
                            <button id="btn-report-work" class="btn btn-success" style="display: none;" onclick="openReportWorkModal(0)"><i class="fas fa-file-alt"></i> 报工</button>
                            <button id="btn-report-check" class="btn btn-success" style="display: none;" onclick="openReportCheckModal(0)"><i class="fas fa-check-circle"></i> 报检</button>
                            <button id="btn-lock-work-order" class="btn btn-danger" style="display: none;" onclick="lockWorkOrder(0)"><i class="fas fa-lock"></i> 锁定</button>
                            <button id="btn-unlock-work-order" class="btn btn-primary" style="display: none;" onclick="unlockWorkOrder(0)"><i class="fas fa-unlock"></i> 解锁</button>
                            <button id="btn-finish-work-order" class="btn btn-success" style="display: none;" onclick="finishWorkOrder(0)"><i class="fas fa-check-double"></i> 完工</button>
                            <button class="btn btn-secondary" onclick="searchData()"><i class="fas fa-search"></i> 查询</button>
                            <button class="btn btn-secondary" onclick="exportData()"><i class="fas fa-download"></i> 导出</button>
                        </div>
                    </div>
                    <div class="data-table">
                        <table>
                            <thead id="table-header"></thead>
                            <tbody id="table-body"></tbody>
                        </table>
                    </div>
                `;
            }

            // 更新模块标题
            const moduleTitles = {
                'workshop': '车间管理',
                'production-line': '产线管理',
                'team': '班组管理',
                'material': '物料数据',
                'bom': 'BOM数据',
                'template': '模板管理',
                'exception': '异常机制',
                'skill': '生产技能',
                'personnel': '人员管理',
                'process': '工序管理',
                'product-process': '产品工艺',
                'production-order': '生产订单',
                'factory-calendar': '工厂日历',
                'production-plan': '生产计划',
                'work-order': '生产工单',
                'pre-check': '产前点检',
                'material-request': '领料申请单',
                'material-transfer': '领料交接单',
                'worker-on-duty': '人员上工',
                'material-online': '物料上线',
                'production-report': '生产报工单',
                'quality-report': '生产报检单',
                'quality-inspection': '生产检验单',
                'rework-notice': '质量返工通知单',
                'repair-record': '返修记录',
                'production-return': '生产退料',
                'production-storage': '生产入库',
                'rework-management': '改制管理',
                'exception-management': '异常管理',
                'time-report': '工时汇报',
                'five-s-check': '5S点检',
                'test-order': '测试工单',
                'repair-transfer': '维修调拨',
                'package-check': '打包检查',
                'kit-inbound': '套件入库',
                'repair-order': '维修工单',
                'repair-issue': '维修领料',
                'sn-reprint': 'SN码补打',
                'product-replace': '产品换件',
                'repair-inspection': '维修报检单',
                'terminal-home': '终端主页'
            };
            document.getElementById('module-title').textContent = moduleTitles[module];

            // 显示/隐藏合并按钮
            const mergeBtn = document.getElementById('merge-btn');
            if (module === 'production-plan') {
                mergeBtn.style.display = 'inline-block';
            } else {
                mergeBtn.style.display = 'none';
            }

            // 控制新增、编辑、删除按钮的显示
            const addBtn = document.getElementById('btn-add');
            const editBtn = document.getElementById('btn-edit');
            const deleteBtn = document.getElementById('btn-delete');
            const confirmBtn = document.getElementById('btn-confirm');
            
            // 默认隐藏生产工单特有按钮
            const btnMaterialRequest = document.getElementById('btn-material-request');
            const btnStartWork = document.getElementById('btn-start-work');
            const btnWorkerOnDuty = document.getElementById('btn-worker-on-duty');
            const btnMaterialOnline = document.getElementById('btn-material-online');
            const btnReportWork = document.getElementById('btn-report-work');
            const btnReportCheck = document.getElementById('btn-report-check');
            const btnLockWorkOrder = document.getElementById('btn-lock-work-order');
            const btnUnlockWorkOrder = document.getElementById('btn-unlock-work-order');
            const btnFinishWorkOrder = document.getElementById('btn-finish-work-order');
            
            btnMaterialRequest.style.display = 'none';
            btnStartWork.style.display = 'none';
            btnWorkerOnDuty.style.display = 'none';
            btnMaterialOnline.style.display = 'none';
            btnReportWork.style.display = 'none';
            btnReportCheck.style.display = 'none';
            btnLockWorkOrder.style.display = 'none';
            btnUnlockWorkOrder.style.display = 'none';
            btnFinishWorkOrder.style.display = 'none';

            // 物料数据、BOM数据：隐藏新增和删除按钮
            if (module === 'material' || module === 'bom') {
                addBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                editBtn.style.display = 'inline-block';
                confirmBtn.style.display = 'none';
            }
            // 生产订单：隐藏新增、删除按钮，显示确认按钮，编辑改为同步
            else if (module === 'production-order') {
                addBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                editBtn.style.display = 'inline-block';
                editBtn.innerHTML = '<i class="fas fa-sync-alt"></i> 同步';
                confirmBtn.style.display = 'inline-block';
            }
            // 生产计划：隐藏新增按钮
            else if (module === 'production-plan') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'inline-block';
                deleteBtn.style.display = 'inline-block';
                confirmBtn.style.display = 'none';
            }
            // 生产工单：隐藏新增、编辑、删除按钮，显示生产工单操作按钮
            else if (module === 'work-order') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'none';
                
                // 显示生产工单操作按钮
                const btnMaterialRequest = document.getElementById('btn-material-request');
                const btnStartWork = document.getElementById('btn-start-work');
                const btnWorkerOnDuty = document.getElementById('btn-worker-on-duty');
                const btnMaterialOnline = document.getElementById('btn-material-online');
                const btnReportWork = document.getElementById('btn-report-work');
                const btnReportCheck = document.getElementById('btn-report-check');
                const btnLockWorkOrder = document.getElementById('btn-lock-work-order');
                const btnUnlockWorkOrder = document.getElementById('btn-unlock-work-order');
                const btnFinishWorkOrder = document.getElementById('btn-finish-work-order');
                
                btnMaterialRequest.style.display = 'inline-block';
                btnStartWork.style.display = 'inline-block';
                btnWorkerOnDuty.style.display = 'inline-block';
                btnMaterialOnline.style.display = 'inline-block';
                btnReportWork.style.display = 'inline-block';
                btnReportCheck.style.display = 'inline-block';
                btnLockWorkOrder.style.display = 'inline-block';
                btnUnlockWorkOrder.style.display = 'inline-block';
                btnFinishWorkOrder.style.display = 'inline-block';
            }
            // 领料申请单：隐藏新增、编辑、删除按钮，显示确认
            else if (module === 'material-request') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 领料交接单：隐藏新增按钮，显示编辑删除
            else if (module === 'material-transfer') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'inline-block';
                deleteBtn.style.display = 'inline-block';
                confirmBtn.style.display = 'none';
            }
            // 人员上工：隐藏新增按钮，隐藏删除
            else if (module === 'worker-on-duty') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'inline-block';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'none';
            }
            // 物料上线：隐藏新增按钮
            else if (module === 'material-online') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'inline-block';
                deleteBtn.style.display = 'inline-block';
                confirmBtn.style.display = 'none';
            }
            // 生产报工单：隐藏新增按钮，显示确认
            else if (module === 'production-report') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 生产报检单：隐藏新增按钮，隐藏删除
            else if (module === 'quality-report') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'inline-block';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'none';
            }
            // 生产检验单：隐藏新增按钮，显示确认
            else if (module === 'quality-inspection') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 质量返工通知单：隐藏新增、删除按钮
            else if (module === 'rework-notice') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'inline-block';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'none';
            }
            // 返修记录：隐藏新增按钮，显示确认
            else if (module === 'repair-record') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 生产退料：隐藏新增按钮，显示确认
            else if (module === 'production-return') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 生产入库：隐藏新增按钮，显示确认
            else if (module === 'production-storage') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 改制管理：隐藏新增、编辑、删除按钮，显示确认
            else if (module === 'rework-management') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 异常管理：隐藏新增、编辑、删除按钮，显示确认/消警/消除/升级
            else if (module === 'exception-management') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 工时汇报：隐藏新增按钮，显示确认
            else if (module === 'time-report') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 5S点检：隐藏新增按钮，显示确认
            else if (module === 'five-s-check') {
                addBtn.style.display = 'none';
                editBtn.style.display = 'none';
                deleteBtn.style.display = 'none';
                confirmBtn.style.display = 'inline-block';
            }
            // 其他模块：显示所有按钮
            else {
                addBtn.style.display = 'inline-block';
                editBtn.style.display = 'inline-block';
                deleteBtn.style.display = 'inline-block';
                confirmBtn.style.display = 'none';
            }

            // 更新表格头部
            updateTableHeader(module);
            
            // 模拟切换数据表格内容
            updateTableContent(module);
        }

        // 更新表格头部
        function updateTableHeader(module) {
            const tableHeader = document.getElementById('table-header');
            let headerHTML = '';

            switch(module) {
                case 'workshop':
                    headerHTML = `
                        <tr>
                            <th><input type="checkbox"></th>
                            <th>车间编码</th>
                            <th>车间名称</th>
                            <th>状态</th>
                            <th>默认产线</th>
                            <th>创建人</th>
                            <th>创建时间</th>
                            <th>修改人</th>
                            <th>修改时间</th>
                            <th>备注</th>
                            <th>操作</th>
                        </tr>
                    `;
                    break;
                case 'production-line':
                    headerHTML = `
                        <tr>
                            <th><input type="checkbox"></th>
