            `;
            
            details.materials.forEach(material => {
                html += `
                    <tr>
                        <td>${material.materialCode}</td>
                        <td>${material.materialName}</td>
                        <td>${material.spec}</td>
                        <td>${material.originalReturnQty}</td>
                        <td>${material.newIssueQty}</td>
                        <td>${material.pendingQty}</td>
                        <td>${material.batchCode}</td>
                    </tr>
                `;
            });
            
            html += `
