                            </div>
                        `;
                    }
                    break;
                case 'sn-reprint':
                    if (type === 'verify') {
                        title = 'SN码验证';
                        formHTML = `
                            <div class="form-group">
                                <label for="form-sn-code">扫描SN号</label>
