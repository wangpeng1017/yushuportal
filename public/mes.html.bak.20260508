            ];

            checks.forEach(item => {
                const auditStatusClass = item.auditStatus === '已审核' ? 'status-success' : 'status-warning';
                const storageStatusClass = item.storageStatus === '已入库' ? 'status-success' : 'status-warning';
                const isCompleteClass = item.isComplete === '是' ? 'status-success' : 'status-danger';
                
                const row = `
                    <tr>
                        <td><input type="checkbox"></td>
                        <td><span class="status-tag ${auditStatusClass}">${item.auditStatus}</span></td>
                        <td><span class="status-tag ${storageStatusClass}">${item.storageStatus}</span></td>
                        <td><span class="status-tag ${isCompleteClass}">${item.isComplete}</span></td>
                        <td>${item.suiteCode}</td>
                        <td>${item.materialCode}</td>
                        <td>${item.materialName}</td>
                        <td>${item.spec}</td>
                        <td>${item.childCode}</td>
                        <td>${item.childMaterialCode}</td>
                        <td>${item.childMaterialName}</td>
                        <td>${item.childSpec}</td>
                        <td>${item.workOrderCode}</td>
                        <td>${item.workshop}</td>
                        <td>${item.line}</td>
                        <td>${item.team}</td>
                        <td>${item.attachment}</td>
                        <td>${item.creator}</td>
                        <td>${item.createTime}</td>
                        <td>${item.remark}</td>
                        <td>
                            <button class="btn btn-danger" style="padding: 4px 8px; font-size: 12px; margin-right: 4px;"><i class="fas fa-trash"></i></button>
                            <button class="btn btn-success" style="padding: 4px 8px; font-size: 12px;">审核</button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

        // 生产退料模态框函数
        function closeProductionReturnModal() {
            const modal = document.getElementById('production-return-modal');
            modal.classList.remove('show');
        }

        function confirmProductionReturn() {
            const workOrder = document.getElementById('return-workorder-select').value;
            const batchCode = document.getElementById('return-batch-code').value;
            const qty = document.getElementById('return-qty-input').value;
            const returnType = document.getElementById('return-type-select').value;
            if (!batchCode) {
                alert('请扫描物料批次码！');
                return;
            }
            alert(`退料成功！工单：${workOrder}，批次码：${batchCode}，数量：${qty}，类型：${returnType}`);
            closeProductionReturnModal();
        }

        // 生产入库模态框函数
        function closeProductionStorageModal() {
            const modal = document.getElementById('production-storage-modal');
            modal.classList.remove('show');
        }

        function confirmProductionStorage() {
            const batchCode = document.getElementById('storage-batch-code').value;
            const qty = document.getElementById('storage-qty-input').value;
            const warehouse = document.getElementById('storage-warehouse-select').value;
            if (!batchCode) {
                alert('请扫描物料批次码！');
                return;
            }
            alert(`入库成功！批次码：${batchCode}，数量：${qty}，仓库：${warehouse}`);
            closeProductionStorageModal();
        }

        // 异常管理模态框函数
        function closeExceptionModal() {
            const modal = document.getElementById('exception-modal');
            modal.classList.remove('show');
        }

        function confirmException() {
            const category = document.getElementById('exception-category-select').value;
            const level = document.getElementById('exception-level-select').value;
            const desc = document.getElementById('exception-desc').value;
            if (!desc) {
                alert('请填写异常描述！');
                return;
            }
            alert(`异常提交成功！分类：${category}，等级：${level}`);
            closeExceptionModal();
        }

        // 工时汇报模态框函数
        function closeTimeReportModal() {
            const modal = document.getElementById('time-report-modal');
            modal.classList.remove('show');
        }

        function confirmTimeReport() {
            const workOrder = document.getElementById('report-workorder-select').value;
            const process = document.getElementById('report-process-select').value;
            const timeType = document.getElementById('time-type-select').value;
            const workerBadge = document.getElementById('time-worker-badge').value;
            const hours = document.getElementById('time-hours-input').value;
            if (!workerBadge) {
                alert('请扫描人员工牌或输入工号！');
                return;
            }
            alert(`工时汇报成功！工单：${workOrder}，工序：${process}，工时类型：${timeType}，工号：${workerBadge}，工时：${hours}小时`);
            closeTimeReportModal();
        }

        // 初始化页面
        document.addEventListener('DOMContentLoaded', function() {
            // 展开产线终端菜单
            const menuItems = document.querySelectorAll('.menu-item');
            menuItems.forEach((item, index) => {
                if (item.textContent.includes('产线终端')) {
                    toggleSubmenu(item);
                }
            });
            
            // 设置终端主页为激活状态
            const terminalItem = document.querySelector('.submenu-item[onclick="switchModule(\'terminal-home\')"]');
            if (terminalItem) {
                terminalItem.classList.add('active');
            }
            
            // 加载终端主页
            generateTerminalHomePage();
        });
    </script>
</body>
</html>