                        </div>
                        <div style="display: flex; gap: 15px;">
                            <div class="form-group" style="flex: 1;">
                                <label for="form-part-batch-code">配件批次码</label>
                                <input type="text" id="form-part-batch-code" placeholder="请扫描配件批次码">
                            </div>
