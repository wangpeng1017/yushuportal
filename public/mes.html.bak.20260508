                    {category: '工艺检查', name: '工艺文件', content: '检查工艺文件完整性', standard: '文件齐全', method: '查阅资料', checkValue: '齐全', pass: '合格', remark: '工艺准备就绪', attachment: ''}
                ],
                'PRE003': [
