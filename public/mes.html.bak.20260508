                        {materialCode: 'MAT009', materialName: '轴承', spec: '6204', originalReturnQty: 200, newIssueQty: 200, pendingQty: 0, batchCode: 'BATCH005'}
                    ],
                    batches: [
                        {batchCode: 'BATCH004', materialCode: 'MAT008', materialName: '齿轮', spec: '1:50', originalWorkOrder: 'WO002', newWorkOrder: 'WO007'},
                        {batchCode: 'BATCH005', materialCode: 'MAT009', materialName: '轴承', spec: '6204', originalWorkOrder: 'WO002', newWorkOrder: 'WO007'}
                    ]
                },
                'RW003': {
                    materials: [
                        {materialCode: 'MAT011', materialName: '传感器芯片', spec: '10mm', originalReturnQty: 50, newIssueQty: 50, pendingQty: 0, batchCode: 'BATCH006'},
                        {materialCode: 'MAT018', materialName: '传感器外壳', spec: '10mm', originalReturnQty: 50, newIssueQty: 50, pendingQty: 0, batchCode: 'BATCH007'}
                    ],
                    batches: [
                        {batchCode: 'BATCH006', materialCode: 'MAT011', materialName: '传感器芯片', spec: '10mm', originalWorkOrder: 'WO003', newWorkOrder: 'WO008'},
                        {batchCode: 'BATCH007', materialCode: 'MAT018', materialName: '传感器外壳', spec: '10mm', originalWorkOrder: 'WO003', newWorkOrder: 'WO008'}
                    ]
                }
            };
            
            const details = reworkDetails[reworkCode] || {materials: [], batches: []};
            
            let html = `
                <h4 style="margin-bottom: 10px; color: var(--primary-color);">原材料迁移表</h4>
                <div class="data-table" style="margin-bottom: 20px;">
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
