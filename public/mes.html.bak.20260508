        // 生产计划数据
        let productionPlans = [];

        // 生成生产计划表格
        function generateProductionPlanTable(tbody) {
            productionPlans = [
                {confirmStatus: '未确认', dispatchStatus: '未派工', planNo: 'PLAN001', orderNo: 'SCDD001', lineNo: '1', materialCode: 'MAT001', materialName: '电机', spec: '1.5kW', planQty: '100', dispatchedQty: '0', unit: '台', startDate: '2026-04-26', endDate: '2026-04-30', workshop: 'C端生产车间', creator: 'admin', createTime: '2026-04-25 11:00:00', modifier: 'admin', modifyTime: '2026-04-25 11:00:00', remark: '电机生产计划'},
                {confirmStatus: '已确认', dispatchStatus: '部分派工', planNo: 'PLAN002', orderNo: 'SCDD002', lineNo: '1', materialCode: 'MAT002', materialName: '减速器', spec: '1:50', planQty: '200', dispatchedQty: '100', unit: '个', startDate: '2026-04-27', endDate: '2026-05-01', workshop: 'B端生产车间', creator: 'admin', createTime: '2026-04-25 11:05:00', modifier: 'admin', modifyTime: '2026-04-25 11:05:00', remark: '减速器生产计划'},
                {confirmStatus: '已确认', dispatchStatus: '已派工', planNo: 'PLAN003', orderNo: 'FGDD001', lineNo: '1', materialCode: 'MAT003', materialName: '传感器', spec: '10mm', planQty: '50', dispatchedQty: '50', unit: '个', startDate: '2026-04-25', endDate: '2026-04-26', workshop: 'C端生产车间', creator: 'admin', createTime: '2026-04-25 11:10:00', modifier: 'admin', modifyTime: '2026-04-25 11:10:00', remark: '传感器生产计划'}
            ];

            productionPlans.forEach((plan, index) => {
                let confirmStatusClass = plan.confirmStatus === '已确认' ? 'status-success' : 'status-danger';
                let dispatchStatusClass = '';
                
                switch(plan.dispatchStatus) {
                    case '未派工':
                        dispatchStatusClass = 'status-danger';
                        break;
                    case '部分派工':
                        dispatchStatusClass = 'status-warning';
                        break;
                    case '已派工':
                        dispatchStatusClass = 'status-success';
                        break;
                }
                
                const row = `
                    <tr>
                        <td><input type="checkbox"></td>
                        <td><span class="status-tag ${confirmStatusClass}">${plan.confirmStatus}</span></td>
                        <td><span class="status-tag ${dispatchStatusClass}">${plan.dispatchStatus}</span></td>
                        <td>${plan.planNo}</td>
                        <td>${plan.orderNo}</td>
                        <td>${plan.lineNo}</td>
                        <td>${plan.materialCode}</td>
                        <td>${plan.materialName}</td>
                        <td>${plan.spec}</td>
                        <td>${plan.planQty}</td>
                        <td>${plan.dispatchedQty}</td>
                        <td>${plan.unit}</td>
                        <td>${plan.startDate}</td>
                        <td>${plan.endDate}</td>
                        <td>${plan.workshop}</td>
                        <td>${plan.creator}</td>
                        <td>${plan.createTime}</td>
                        <td>${plan.modifier}</td>
                        <td>${plan.modifyTime}</td>
                        <td>${plan.remark}</td>
                        <td>
                            <button class="btn btn-primary" style="padding: 4px 8px; font-size: 12px; margin-right: 4px;" onclick="openSplitModal(${index})"><i class="fas fa-columns"></i> 拆分</button>
                            <button class="btn btn-success" style="padding: 4px 8px; font-size: 12px; margin-right: 4px;"><i class="fas fa-check"></i> 确认</button>
                            <button class="btn btn-success" style="padding: 4px 8px; font-size: 12px;" onclick="openDispatchModal(${index})"><i class="fas fa-user-plus"></i> 派工</button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

        // 生成默认表格
        function generateDefaultTable(tbody, module) {
            const moduleNames = {
                'bom': 'BOM数据',
                'exception': '异常机制',
                'skill': '生产技能'
            };
            
            const rows = [
                {code: '001', name: `${moduleNames[module]}1`, status: 'normal', creator: 'admin', createTime: '2026-04-01 09:00:00', modifier: 'admin', modifyTime: '2026-04-01 09:00:00', remark: `${moduleNames[module]}示例1`},
                {code: '002', name: `${moduleNames[module]}2`, status: 'normal', creator: 'admin', createTime: '2026-04-01 09:05:00', modifier: 'admin', modifyTime: '2026-04-01 09:05:00', remark: `${moduleNames[module]}示例2`},
                {code: '003', name: `${moduleNames[module]}3`, status: 'normal', creator: 'admin', createTime: '2026-04-01 09:10:00', modifier: 'admin', modifyTime: '2026-04-01 09:10:00', remark: `${moduleNames[module]}示例3`}
            ];

            rows.forEach(rowData => {
                const statusClass = rowData.status === 'normal' ? 'status-success' : 'status-danger';
                const statusText = rowData.status === 'normal' ? '正常' : '停用';
                
                const row = `
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>${rowData.code}</td>
                        <td>${rowData.name}</td>
                        <td><span class="status-tag ${statusClass}">${statusText}</span></td>
                        <td>${rowData.creator}</td>
                        <td>${rowData.createTime}</td>
                        <td>${rowData.modifier}</td>
                        <td>${rowData.modifyTime}</td>
                        <td>${rowData.remark}</td>
                        <td>
                            <button class="btn btn-primary" style="padding: 4px 8px; font-size: 12px;" onclick="openModal('edit')"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-danger" style="padding: 4px 8px; font-size: 12px;" onclick="confirmDelete()"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

        // 获取当前激活的模块
        function getCurrentModule() {
            const activeItem = document.querySelector('.submenu-item.active');
            if (activeItem) {
                const text = activeItem.textContent.trim();
                const moduleMap = {
                    '车间管理': 'workshop',
                    '产线管理': 'production-line',
                    '班组管理': 'team',
                    '物料数据': 'material',
                    'BOM数据': 'bom',
                    '模板管理': 'template',
                    '异常机制': 'exception',
                    '生产技能': 'skill',
                    '人员管理': 'personnel',
                    '工序管理': 'process',
                    '产品工艺': 'product-process',
                    '生产订单': 'production-order',
                    '工厂日历': 'factory-calendar',
                    '生产计划': 'production-plan',
                    '生产工单': 'work-order',
                    '产前点检': 'pre-check',
                    '领料申请单': 'material-request',
                    '领料交接单': 'material-transfer',
                    '人员上工': 'worker-on-duty',
                    '物料上线': 'material-online',
                    '生产报工单': 'production-report',
                    '生产报检单': 'quality-report',
                    '生产检验单': 'quality-inspection',
                    '质量返工通知单': 'rework-notice',
                    '返修记录': 'repair-record',
                    '生产退料': 'production-return',
                    '生产入库': 'production-storage',
                    '改制管理': 'rework-management',
                    '异常管理': 'exception-management',
                    '工时汇报': 'time-report',
                    '5S点检': 'five-s-check',
                    '测试工单': 'test-order',
                    '维修调拨': 'repair-transfer',
                    '打包检查': 'package-check',
                    '套件入库': 'kit-inbound',
                    '维修工单': 'repair-order',
                    '维修领料': 'repair-issue',
                    'SN码补打': 'sn-reprint',
                    '产品换件': 'product-replace',
                    '维修报检单': 'repair-inspection',
                    '终端主页': 'terminal-home'
                };
                return moduleMap[text] || 'workshop';
            }
            return 'workshop';
        }

        // 打开模态框
        function openModal(type) {
            const modal = document.getElementById('edit-modal');
            const modalTitle = document.getElementById('modal-title');
            const form = document.getElementById('edit-form');
            const currentModule = getCurrentModule();
            
            // 生成不同模块的表单
            let formHTML = '';
            let title = '';
            
            switch(currentModule) {
                case 'workshop':
                    title = type === 'add' ? '新增车间' : '编辑车间';
                    formHTML = `
                        <div class="form-group">
                            <label for="form-code">车间编码</label>
                            <input type="text" id="form-code" placeholder="请输入车间编码">
                        </div>
                        <div class="form-group">
                            <label for="form-name">车间名称</label>
                            <input type="text" id="form-name" placeholder="请输入车间名称">
                        </div>
                        <div class="form-group">
                            <label for="form-status">状态</label>
                            <select id="form-status">
                                <option value="normal">正常</option>
                                <option value="maintenance">维护中</option>
                                <option value="disabled">未启用</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-remark">备注</label>
                            <textarea id="form-remark" placeholder="请输入备注信息"></textarea>
                        </div>
                    `;
                    break;
                case 'production-line':
                    title = type === 'add' ? '新增产线' : '编辑产线';
                    formHTML = `
                        <div class="form-group">
                            <label for="form-code">产线编码</label>
                            <input type="text" id="form-code" placeholder="请输入产线编码">
                        </div>
                        <div class="form-group">
                            <label for="form-name">产线名称</label>
                            <input type="text" id="form-name" placeholder="请输入产线名称">
                        </div>
                        <div class="form-group">
                            <label for="form-workshop">所属车间</label>
                            <select id="form-workshop">
                                <option value="C001">C端生产车间</option>
                                <option value="B001">B端生产车间</option>
                                <option value="M001">机加工车间</option>
                                <option value="L001">物流服务车间</option>
                                <option value="S001">售后维修车间</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-status">状态</label>
                            <select id="form-status">
                                <option value="normal">正常</option>
                                <option value="maintenance">维护中</option>
                                <option value="disabled">未启用</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-remark">备注</label>
                            <textarea id="form-remark" placeholder="请输入备注信息"></textarea>
                        </div>
                    `;
                    break;
                case 'team':
                    title = type === 'add' ? '新增班组' : '编辑班组';
                    formHTML = `
                        <div class="form-group">
                            <label for="form-code">班组编码</label>
                            <input type="text" id="form-code" placeholder="请输入班组编码">
                        </div>
                        <div class="form-group">
                            <label for="form-name">班组名称</label>
                            <input type="text" id="form-name" placeholder="请输入班组名称">
                        </div>
                        <div class="form-group">
                            <label for="form-production-line">所属产线</label>
                            <select id="form-production-line">
                                <option value="C001-01">C端装配线</option>
                                <option value="B001-01">B端装配线</option>
                                <option value="M001-01">机加工线</option>
                                <option value="L001-01">物流分拣线</option>
                                <option value="S001-01">维修线</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-status">状态</label>
                            <select id="form-status">
                                <option value="normal">正常</option>
                                <option value="maintenance">维护中</option>
                                <option value="disabled">未启用</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-remark">备注</label>
                            <textarea id="form-remark" placeholder="请输入备注信息"></textarea>
                        </div>
                    `;
                    break;
                case 'material':
                    title = type === 'add' ? '新增物料' : '编辑物料';
                    const materialDisabled = type === 'edit' ? 'disabled' : '';
                    formHTML = `
                        <div class="form-group">
                            <label for="form-code">物料编码</label>
                            <input type="text" id="form-code" placeholder="请输入物料编码" ${materialDisabled}>
                        </div>
                        <div class="form-group">
                            <label for="form-name">物料名称</label>
                            <input type="text" id="form-name" placeholder="请输入物料名称" ${materialDisabled}>
                        </div>
                        <div class="form-group">
                            <label for="form-spec">规格型号</label>
                            <input type="text" id="form-spec" placeholder="请输入规格型号" ${materialDisabled}>
                        </div>
                        <div class="form-group">
                            <label for="form-sn-managed">是否SN管理</label>
                            <select id="form-sn-managed">
                                <option value="是">是</option>
                                <option value="否">否</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-batch-rule">批次码规则</label>
                            <input type="text" id="form-batch-rule" placeholder="请输入批次码规则">
                        </div>
                        <div class="form-group">
                            <label for="form-lead-time">生产提前天数</label>
                            <input type="number" id="form-lead-time" placeholder="请输入生产提前天数">
                        </div>
                        <div class="form-group">
                            <label for="form-pack-check">是否打包校验</label>
                            <select id="form-pack-check">
                                <option value="是">是</option>
                                <option value="否">否</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-test-check">是否需测试</label>
                            <select id="form-test-check">
                                <option value="是">是</option>
                                <option value="否">否</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-status">状态</label>
                            <select id="form-status">
                                <option value="normal">正常</option>
                                <option value="disabled">停用</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="form-remark">备注</label>
                            <textarea id="form-remark" placeholder="请输入备注信息"></textarea>
                        </div>
                    `;
                    break;
                case 'template':
                    title = type === 'add' ? '新增模板' : '编辑模板';
                    const templateDisabled = type === 'edit' ? 'disabled' : '';
                    formHTML = `
                        <div class="form-group">
                            <label for="form-code">模板编码</label>
                            <input type="text" id="form-code" placeholder="请输入模板编码" ${templateDisabled}>
                        </div>
                        <div class="form-group">
                            <label for="form-name">模板名称</label>
