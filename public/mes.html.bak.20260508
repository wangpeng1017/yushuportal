                    {category: '设备检查', name: '设备润滑', content: '检查设备润滑情况', standard: '润滑充分', method: '查看油位', checkValue: '油位低', pass: '不合格', remark: '需要补充润滑油', attachment: ''}
                ],
                'PRE004': [
                    {category: '安全检查', name: '防护装置', content: '检查安全防护装置', standard: '防护到位', method: '目视检查', checkValue: '正常', pass: '合格', remark: '安全措施到位', attachment: ''},
                    {category: '安全检查', name: '急停按钮', content: '检查急停按钮功能', standard: '功能正常', method: '手动测试', checkValue: '正常', pass: '合格', remark: '急停功能正常', attachment: ''}
                ]
            };
            
            // 根据模板编码查找对应的数据
            let details = templateDetails[templateCode] || [];
            let isInspection = false;
            
            // 如果是检验单号（INSP开头），使用检验单明细数据
            if (templateCode.startsWith('INSP')) {
                details = inspectionDetails[templateCode] || [];
                isInspection = true;
            }
            
            // 如果是产前点检单号（PRE开头），使用产前点检明细数据
            if (templateCode.startsWith('PRE')) {
                details = preCheckDetails[templateCode] || [];
                isInspection = true;
            }
            
            let tableHTML = `
                <div class="data-table">
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>检验分类</th>
                                    <th>检验项</th>
                                    <th>检验内容</th>
                                    <th>合格标准</th>
                                    <th>检验方法</th>
                                    <th>检验值</th>
                                    <th>检验结果</th>
                                    <th>备注</th>
                                    <th>附件</th>
                                </tr>
                            </thead>
                            <tbody>
            `;
            
            details.forEach((detail, index) => {
                if (isInspection || templateCode.startsWith('5S')) {
                    tableHTML += `
                        <tr>
                            <td>${detail.category}</td>
                            <td>${detail.name}</td>
                            <td>${detail.content}</td>
                            <td>${detail.standard}</td>
                            <td>${detail.method || ''}</td>
                            <td><input type="text" value="${detail.checkValue || ''}" style="width: 100px; padding: 4px;" id="check-value-${index}"></td>
                            <td>
                                <select style="width: 80px; padding: 4px;" id="pass-select-${index}">
                                    <option value="合格" ${(detail.pass || '') === '合格' ? 'selected' : ''}>合格</option>
                                    <option value="不合格" ${(detail.pass || '') === '不合格' ? 'selected' : ''}>不合格</option>
                                </select>
                            </td>
                            <td><input type="text" value="${detail.remark || ''}" style="width: 100px; padding: 4px;" id="remark-input-${index}"></td>
                            <td><button class="btn btn-primary" style="padding: 2px 6px; font-size: 11px;">上传</button></td>
                        </tr>
                    `;
                } else {
                    tableHTML += `
                        <tr>
                            <td>${detail.category}</td>
                            <td>${detail.name}</td>
                            <td>${detail.content}</td>
                            <td>${detail.standard}</td>
                            <td>${detail.method}</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    `;
                }
            });
            
            tableHTML += `
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
            
            modalBody.innerHTML = tableHTML;
            modal.classList.add('show');
        }

        // 打开测试工单明细模态框
        function openTestDetailModal(testCode) {
            const modal = document.getElementById('detail-modal');
            const modalTitle = document.getElementById('detail-title');
            const modalBody = document.querySelector('.detail-content .modal-body');
            
            modalTitle.textContent = `测试明细 - ${testCode}`;
            
            // 测试工单明细数据
            const testDetails = {
                'TEST001': [
                    {category: '性能测试', name: '输出功率', content: '测试电机输出功率', standard: '≥95%', method: '功率测试仪', checkValue: '96.5', pass: '合格', remark: '正常', attachment: ''},
                    {category: '性能测试', name: '效率', content: '测试电机效率', standard: '≥90%', method: '效率测试仪', checkValue: '92.3', pass: '合格', remark: '正常', attachment: ''},
                    {category: '性能测试', name: '温升', content: '测试电机温升', standard: '≤80℃', method: '温度计', checkValue: '65', pass: '合格', remark: '正常', attachment: ''}
                ],
                'TEST002': [
                    {category: '外观检查', name: '表面质量', content: '检查产品表面质量', standard: '无划痕、无变形', method: '目视检查', checkValue: '有轻微划痕', pass: '不合格', remark: '需返工', attachment: ''},
                    {category: '外观检查', name: '标识', content: '检查产品标识', standard: '标识清晰', method: '目视检查', checkValue: '清晰', pass: '合格', remark: '正常', attachment: ''}
                ],
                'TEST003': [
                    {category: '性能测试', name: '灵敏度', content: '测试传感器灵敏度', standard: '≥100mV/g', method: '灵敏度测试仪', checkValue: '105', pass: '合格', remark: '正常', attachment: ''},
                    {category: '性能测试', name: '响应时间', content: '测试传感器响应时间', standard: '≤10ms', method: '示波器', checkValue: '8', pass: '合格', remark: '正常', attachment: ''}
                ]
            };
            
            const details = testDetails[testCode] || [];
            
            let tableHTML = `
                <div class="data-table">
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>检验分类</th>
                                    <th>检验项</th>
                                    <th>检验内容</th>
                                    <th>合格标准</th>
                                    <th>检验方法</th>
                                    <th>检验值</th>
                                    <th>是否合格</th>
                                    <th>检验备注</th>
                                    <th>附件</th>
                                </tr>
                            </thead>
                            <tbody>
            `;
            
            details.forEach((detail, index) => {
                tableHTML += `
                    <tr>
                        <td>${detail.category}</td>
                        <td>${detail.name}</td>
                        <td>${detail.content}</td>
                        <td>${detail.standard}</td>
                        <td>${detail.method}</td>
                        <td><input type="text" value="${detail.checkValue}" style="width: 100px; padding: 4px;" id="check-value-${index}"></td>
                        <td>
                            <select style="width: 80px; padding: 4px;" id="pass-select-${index}">
                                <option value="合格" ${detail.pass === '合格' ? 'selected' : ''}>合格</option>
                                <option value="不合格" ${detail.pass === '不合格' ? 'selected' : ''}>不合格</option>
                            </select>
                        </td>
                        <td><input type="text" value="${detail.remark}" style="width: 100px; padding: 4px;" id="remark-input-${index}"></td>
                        <td><button class="btn btn-primary" style="padding: 2px 6px; font-size: 11px;">上传</button></td>
                    </tr>
                `;
            });
            
            tableHTML += `
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
            
            modalBody.innerHTML = tableHTML;
            modal.classList.add('show');
        }

